  },
  "engines": {
    "node": ">=12.0.0"
  },
  "scripts": {
    "start": "node ./bootstrap.js",
    "dev": "pnpm build && cross-env NODE_ENV=local concurrently --kill-others \"tsc -p tsconfig.json --watch --preserveWatchOutput\" \"node --watch bootstrap.js\"",
    "test": "jest --runInBand",
    "cov": "jest --runInBand --coverage",
    "lint": "oxlint --deny typescript/no-explicit-any .",
    "ci": "pnpm run cov",
    "build": "rm -rf dist && mkdir -p dist && cp -R src/file dist/file && tsc -p tsconfig.json"
  },
  "midway-bin-clean": [
    ".vscode/.tsbuildinfo",
    "dist"
  ],
